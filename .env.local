# PragatiPulse Environment Variables

# Supabase (PostgreSQL / Auth / Storage)
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key

# Auth & Session
AUTH_SECRET=pragatipulse-local-development-secret-key-32-chars-min

# MongoDB
MONGODB_URI=mongodb://localhost:27017/pragatipulse
MONGODB_DB_NAME=pragatipulse

# AI APIs (Optional)
GOOGLE_API_KEY=
GROQ_API_KEY=
ELEVENLABS_API_KEY=
